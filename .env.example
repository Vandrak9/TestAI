# Port Scanner - konfigurácia prostredia
# Skopírujte tento súbor ako .env a upravte hodnoty

# Anthropic API kľúč (povinné)
ANTHROPIC_API_KEY=sk-ant-...

# Prihlasovacie údaje do web rozhrania
APP_USERNAME=admin
APP_PASSWORD=zmente-toto-heslo

# Flask session secret (generujte: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=generujte-nahodny-kluc

# Port pre web server (default: 5000)
PORT=5000

# Webhook secret pre automatické nasadenie (generujte: openssl rand -hex 32)
WEBHOOK_SECRET=generujte-nahodny-secret
